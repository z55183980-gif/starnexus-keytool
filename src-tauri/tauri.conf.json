{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarNexus Key Tool",
  "version": "0.1.2",
  "identifier": "com.dkby.starnexus.keytool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StarNexus 密钥管理工具",
        "width": 560,
        "height": 884,
        "center": true,
        "minWidth": 560,
        "minHeight": 560,
        "resizable": true,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "mainBinaryName": "starnexus-keytool",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.dkby.starnexus.keytool"
        ]
      }
    }
  }
}
