{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StarNexus Key Tool",
  "version": "0.2.12",
  "identifier": "com.dkby.starnexus.keytool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 480,
        "height": 865,
        "center": true,
        "minWidth": 420,
        "minHeight": 600,
        "maxWidth": 640,
        "resizable": true,
        "maximizable": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "TradChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "12.0"
    }
  },
  "mainBinaryName": "starnexus-keytool",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "com.dkby.starnexus.keytool"
        ]
      }
    },
    "updater": {
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
